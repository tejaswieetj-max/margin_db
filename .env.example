# Database connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=margin_db

# MySQL admin account (used for migrations and stored-routine ownership)
ADMIN_USER=admin_user
ADMIN_PASSWORD=your_admin_password_here

# Service account used by backend telemetry writes
SVC_TELEMETRY_USER=svc_telemetry
SVC_TELEMETRY_PASSWORD=your_telemetry_password_here

# SEC EDGAR User-Agent header (format: "Company Name contact@example.com")
SEC_USER_AGENT=MarginDBUser user@example.com

# JWT signing secret (use a long, random string)
JWT_SECRET=your_jwt_signing_secret_here

# Storage budget for the database in MB (optional override)
DB_ALLOCATED_MB=10240

# Demo account passwords
DEMO_ANALYST_PASSWORD=analystpwd
DEMO_ANALYST_ALL_PASSWORD=ANALYSTpwd
DEMO_ENGINEER_PASSWORD=engpwd

# Demo account usernames
ANALYST_DEMO_USERNAME=analyst_demo
ANALYST_ALL_USERNAME=analyst_all
ENGINEER_DEMO_USERNAME=engineer_demo
